{
  "name": "pathfinding",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "node --openssl-legacy-provider node_modules/@vue/cli-service/bin/vue-cli-service.js serve",
    "build": "node --openssl-legacy-provider node_modules/@vue/cli-service/bin/vue-cli-service.js build",
    "lint": "vue-cli-service lint",
    "test": "node tests/algorithms.test.js && node tests/animation.test.js"
  },
  "dependencies": {
    "@vue/cli-plugin-babel": "4.1.1",
    "bootstrap-vue": "2.21.2",
    "konva": "^8.0.1",
    "vue": "^2.6.11",
    "vue-konva": "2.1.7"
  },
  "devDependencies": {
    "@vue/cli-plugin-eslint": "4.1.1",
    "@vue/cli-service": "4.1.1",
    "babel-eslint": "^10.0.3",
    "eslint": "^6.7.2",
    "eslint-plugin-vue": "^6.2.2",
    "vue-template-compiler": "^2.6.11"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "rules": {
      "no-unused-vars": "off" 
    },
    "parserOptions": {
      "parser": "babel-eslint"
    }
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "keywords": [],
  "description": "Interactive Vue and Konva pathfinding algorithm visualizer"
}
